# Copia este archivo como .env y completa los valores (el .env no se sube a git)

# URL de la API de Supabase
# - Local, probando en el navegador: http://127.0.0.1:54321
# - Local, probando en el teléfono: http://<IP de tu PC en la red WiFi>:54321
# - Nube: https://<id-del-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Llave pública (publishable). La muestra `pnpm db:status` en local o el panel de Supabase en la nube.
# Nunca pongas aquí la llave secreta (secret / service_role): todo lo que empieza con EXPO_PUBLIC_ termina dentro de la app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY =
